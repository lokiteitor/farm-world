{
  "name": "@farm-world/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Nuxt 4 single-page application. Phaser owns the world canvas; every panel is a Vue component and Pinia holds the state received from the server.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt prepare && vue-tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pinia/nuxt": "1.0.1",
    "nuxt": "4.5.2",
    "phaser": "3.90.0",
    "pinia": "4.0.2",
    "vue": "3.5.41",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
