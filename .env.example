# ---------------------------------------------------------------------------
# Farming Management Simulator Online — environment template
#
# Copy to .env (`make bootstrap` does it) and adjust. Two consumers read this
# file, and they need different host names:
#
#   - Host tooling (prisma migrate, seed, vitest integration, tools/balance)
#     talks to the published ports on localhost. That is what the values below
#     are written for.
#   - Containers get postgres:5432 and redis:6379 injected by the compose files,
#     which override these two variables on purpose.
#
# No value here is game balance. Every balance constant lives in
# shared/config/ with its GDD section quoted next to it.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Published host ports
#
# None of the defaults is the canonical port of its service, and that is
# deliberate. A development machine usually already runs PostgreSQL, Redis, a web
# server and a Grafana of another project, and Docker fails to publish a port that
# is taken, which aborts `make up` for the whole stack instead of for one service.
# The in-container ports do not change, so nothing inside the compose network is
# affected: the services keep reaching each other at postgres:5432, redis:6379,
# backend:3000 and frontend:3001.
#
#   Variable          Default  Canonical  Service
#   POSTGRES_PORT     55432    5432       PostgreSQL
#   REDIS_PORT        56379    6379       Redis
#   BACKEND_PORT      3000     3000       Fastify, published for host tooling
#   FRONTEND_DEV_PORT 3100     3001       Nuxt development server
#   HTTP_PORT         8080     80         Caddy, HTTP
#   HTTPS_PORT        8443     443       Caddy, HTTPS (production stack only)
#   PROMETHEUS_PORT   59090    9090      Prometheus (profile "obs")
#   GRAFANA_PORT      53000    3000      Grafana (profile "obs")
#
# The high values follow one rule, prefixing the canonical port with a 5, so that
# a port is recognisable in `ss -ltn` without consulting this table. Before
# raising the stack, check the chosen ports are free:
#
#   ss -ltn | grep -E ':(55432|56379|3000|3100|8080|8443|59090|53000)\b'
#
# A production deployment sets HTTP_PORT=80 and HTTPS_PORT=443 explicitly:
# automatic TLS issuance requires the canonical ports.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=farmworld
POSTGRES_PASSWORD=farmworld
POSTGRES_DB=farmworld
POSTGRES_PORT=55432
DATABASE_URL=postgresql://farmworld:farmworld@localhost:55432/farmworld?schema=public

# Shadow database. Only needed for `prisma migrate diff --from-migrations`, which
# replays the migration history into it and is how the idempotence of the history
# against the datamodel is verified (backend/prisma/README.md, section 8.2), and
# for a managed database where the connection user may not create databases.
# SHADOW_DATABASE_URL=postgresql://farmworld:farmworld@localhost:55432/farmworld_shadow?schema=public

# --- Redis ------------------------------------------------------------------
# Authoritative for nothing: cache, BullMQ transport, pub/sub, replay ring and
# WebSocket tickets only (plan section 5).
REDIS_PORT=56379
REDIS_URL=redis://localhost:56379

# --- Authentication ---------------------------------------------------------
# Replace before any deployment. 32 bytes of base64 is enough:
#   openssl rand -base64 32
JWT_SECRET=development-only-secret-replace-me
# Access token lifetime in seconds (stack section 6: ~15 min).
JWT_ACCESS_TTL=900
# Rotating refresh token lifetime in seconds (30 days).
REFRESH_TTL=2592000

# --- Game clock -------------------------------------------------------------
# Rational multiplier: game milliseconds per real millisecond, as
# GAME_RATE_NUM / GAME_RATE_DEN. Kept rational so the conversion of plan
# section 6.1 is invertible without floating point error.
#
# GDD section 51 leaves the value to server configuration and section 61 shows
# it read-only in the interface, so this is operations, not balance.
#   12 / 1        -> 12 game hours per real hour; the 325 h cycle of section 118
#                    takes about 27 real hours.
#   360000 / 1    -> 1 game hour per 10 real ms, the value `make smoke` uses to
#                    run the whole cycle in about 15 seconds.
#   0 / 1         -> paused world. The clock never rewinds; an incident is
#                    compensated with a ledger entry, not with time.
GAME_RATE_NUM=12
GAME_RATE_DEN=1

# Whether a boot may re-anchor a world that already exists with the two values
# above. False, and the default matters: point 3 of ADR-0007 makes changing the
# multiplier a domain operation (`retimeWorld`), not a configuration update. With
# it on, a `POST /api/dev/retime` did not survive a restart and two processes with
# different environments took the world from each other on every boot. When the
# persisted value and the configured one differ, the world keeps its own and the
# process logs a warning. Set it to true only to apply a deliberate change.
GAME_RATE_APPLY_ON_BOOT=false

# Only events falling due inside this real-time window are enqueued in Redis;
# the rest stay as pending rows in ScheduledEvent (plan section 6.4).
# 86400000 ms = 24 real hours.
SCHEDULE_HORIZON_REAL_MS=86400000

# --- World ------------------------------------------------------------------
# Deterministic terrain generator seed (GDD section 5). Any 32-bit integer.
# Changing it on a populated world is rejected at start-up, because
# World.generatorVersion and the persisted witness cells would no longer match.
WORLD_SEED=20260811

# --- HTTP service -----------------------------------------------------------
# Port the service listens on, inside its container and when run directly on the
# host. Read by backend/src/server.ts.
PORT=3000
# Port the backend is published on for host tooling and the smoke test. Separate
# from PORT because only this one can collide with another project.
BACKEND_PORT=3000
# Port of the metrics listener of the worker, which has no HTTP surface of its
# own. docker-compose.yml injects it into that service and
# infra/prometheus/prometheus.yml scrapes worker:9464/metrics, so the two have to
# agree. The server publishes /metrics on PORT and ignores this one.
METRICS_PORT=9464
# Port Caddy publishes on the host for the prod-like route (/api, /ws, SPA).
HTTP_PORT=8080
# HTTPS, published only by the production stack.
HTTPS_PORT=8443
# Nuxt dev server, reached directly during development.
FRONTEND_DEV_PORT=3100
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Enables POST /api/dev/* (clock jumps, forced settlement, world reset).
# Must stay false outside development.
DEV_ENDPOINTS=false
# Comma-separated list of allowed browser origins. Both entries follow the
# published ports above.
CORS_ORIGIN=http://localhost:3100,http://localhost:8080

# --- Seed -------------------------------------------------------------------
# Creates a test player with the starting capital of GDD section 117. Not
# honoured with NODE_ENV=production, because the password is known.
SEED_DEV_PLAYER=false
SEED_DEV_PLAYER_EMAIL=dev@farm-world.local
SEED_DEV_PLAYER_PASSWORD=farm-world-dev

# --- Observability (docker-compose.obs.yml, profile "obs") ------------------
PROMETHEUS_PORT=59090
GRAFANA_PORT=53000
GRAFANA_ADMIN_PASSWORD=admin
