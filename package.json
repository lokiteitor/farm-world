{
  "name": "farm-world-tooling",
  "version": "0.1.0",
  "private": true,
  "description": "Repository-level lint and format tooling. Not a workspace root: shared/, backend/ and frontend/ are independent npm projects (plan section 4).",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vue-eslint-parser": "10.4.1"
  }
}
