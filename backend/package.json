{
  "name": "@farm-world/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Modular monolith with two entry points: src/server.ts (Fastify HTTP and WebSocket) and src/worker.ts (BullMQ simulation consumer). One image, one dependency tree, two compose services.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.int.config.ts",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/websocket": "11.3.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "0.45.1",
    "bullmq": "5.81.3",
    "fastify": "5.11.3",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "5.11.1",
    "nanoid": "6.0.1",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "prom-client": "15.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "fast-check": "4.9.0",
    "openapi-types": "12.1.3",
    "prisma": "7.9.1",
    "testcontainers": "12.0.4",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
